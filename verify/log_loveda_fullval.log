  score_safety = 1 - P(score < τ/2 | suppressed)  [v1 proxy]
  rel_band = P(λτ ≤ score < τ | class)   high_anchor = P(score ≥ τ | class)  [v2 release-band; λτ=0.1000, τ=0.5]
  deep_noise = P(score < λτ | class)  (λ-rule never releases this mass)
  gmm_tau = GMM crossing on suppressed scores (risk signal in uncertainty-bg mode)
  band_* columns computed on RELEASE BAND only: raw_top1=c ∧ λτ ≤ score < τ
  band_mg  = mean(top1-top2) in band    band_mg25 = q25 of same
  band_bg  = mean(top1-bg)   in band    band_bg25 = q25 of same
  t2_bg    = P(top2_class = background | band)  (runner-up is bg → release risky)
  t2_entr  = entropy of top2_class distribution in band
